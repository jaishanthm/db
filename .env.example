# Environment Configuration for Malware Information Database
ENVIRONMENT=production
DATABASE_URL=sqlite:///data/malware_intel.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://malware_user:malware_pass@localhost:5432/malware_intel

SECRET_KEY=change-in-production-super-secret-key-64-bytes-hex
CORS_ORIGINS=*
PORT=8000

# SQL Explorer Constraints
SQL_MAX_ROWS=300
SQL_TIMEOUT_SECONDS=3.0
SQL_MAX_QUERY_LENGTH=4000
